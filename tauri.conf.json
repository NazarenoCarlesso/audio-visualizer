{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Audio Visualizer",
  "version": "0.1.0",
  "identifier": "com.audio-visualizer.app",
  "build": {
    "beforeDevCommand": "npm --prefix web run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm --prefix web run build",
    "frontendDist": "web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Audio Visualizer",
        "width": 1280,
        "height": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
